{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "WatchProgress": {
      "title": "WatchProgress",
      "description": "User anime watch progress",
      "type": "object",
      "properties": {
        "animeId": { "type": "string" },
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "image": { "type": "string" },
        "episodeId": { "type": "string" },
        "episodeNumber": { "type": "number" },
        "seasonNumber": { "type": "number" },
        "playbackTimestamp": { "type": "number" },
        "duration": { "type": "number" },
        "completionPercentage": { "type": "number" },
        "lastWatchedTime": { "type": "number" },
        "isCompleted": { "type": "boolean" }
      },
      "required": ["animeId", "episodeId", "episodeNumber", "playbackTimestamp"]
    },
    "LibraryItem": {
      "title": "LibraryItem",
      "description": "Saved anime in user library (watchlist, completed, favorites)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "image": { "type": "string" },
        "type": { "type": "string", "enum": ["watchlist", "completed", "favorites"] },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "title", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user account profile"
    },
    "/users/{userId}/progress/{animeId}": {
      "schema": "WatchProgress",
      "description": "Stores user watch progress and continue watching data per anime"
    },
    "/users/{userId}/library/{itemId}": {
      "schema": "LibraryItem",
      "description": "Stores saved anime in user watchlist, completed, and favorites lists"
    }
  }
}
