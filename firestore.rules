rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profile: only the authenticated user can access their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Watch progress subcollection
      match /progress/{animeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Library items (watchlist, completed, favorites)
      match /library/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
